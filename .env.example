# Hatchet (required)
# Leave HATCHET_CLIENT_TOKEN empty to auto-generate one from the local Hatchet on first start,
# or create one with: node scripts/generate-token.js
HATCHET_CLIENT_TOKEN=
HATCHET_HOST_PORT=localhost:7077

# zyk database (created and migrated automatically on server start)
ZYK_DATABASE_URL=postgresql://hatchet:hatchet@localhost:5433/zyk
# Tests drop and recreate this database on every run — never point it at real data
ZYK_TEST_DATABASE_URL=postgresql://hatchet:hatchet@localhost:5433/zyk_test

# zyk server
# Port for the MCP endpoint (default: 3100)
PORT=3100
# Local runtime state (Hatchet token cache). Default: ./data
ZYK_DATA_DIR=
