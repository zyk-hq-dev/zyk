{
  "name": "zyk-mcp",
  "version": "2.0.0-dev",
  "description": "zyk — durable process layer for AI assistants (MCP task API on Hatchet)",
  "main": "dist/index.js",
  "files": [
    "dist",
    "migrations",
    "playbooks"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "admin": "node dist/admin/cli.js",
    "admin:dev": "tsx src/admin/cli.ts"
  },
  "dependencies": {
    "@hatchet-dev/typescript-sdk": "^1.17.2",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true
}
